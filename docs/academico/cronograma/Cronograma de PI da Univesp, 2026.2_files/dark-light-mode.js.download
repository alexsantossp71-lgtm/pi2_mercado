document.addEventListener("DOMContentLoaded", function () {
  const toggleThemeEl = document.querySelector("[data-toggle-theme]");
  const htmlEl = document.documentElement;
  const systemSettingDark = window.matchMedia("(prefers-color-scheme: dark)");

  function getStoredTheme() {
    return localStorage.getItem("theme");
  }

  function saveTheme(theme) {
    localStorage.setItem("theme", theme);
  }

  function getCurrentTheme() {
    const storedTheme = getStoredTheme();
    return storedTheme ? storedTheme : systemSettingDark.matches ? "dark" : "light";
  }

  function applyTheme(theme) {
    htmlEl.setAttribute("data-theme", theme);
    toggleThemeEl.setAttribute("aria-checked", theme === "dark");
    toggleThemeEl.setAttribute("aria-label", theme === "dark" ? "Mudar para tema claro" : "Mudar para tema escuro");
  }

  function toggleTheme() {
    const newTheme = getCurrentTheme() === "dark" ? "light" : "dark";
    saveTheme(newTheme);
    applyTheme(newTheme);
  }

  applyTheme(getCurrentTheme());

  toggleThemeEl.addEventListener("click", toggleTheme);

  toggleThemeEl.addEventListener("keydown", (e) => {
    if (e.key === " " || e.key === "Enter") {
      e.preventDefault();
      toggleTheme();
    }
  });
});