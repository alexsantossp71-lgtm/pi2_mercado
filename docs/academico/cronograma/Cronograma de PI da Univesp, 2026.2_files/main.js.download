const CONFIG = {
  debugMode: false,
  selectors: {
    tableId: "cronograma",
    buttonId: "download-ics",
    icons: {
      download: ".icon-download",
      loading: ".icon-loading"
    }
  },
  metaTags: {
    description: 'meta[name="description"]',
    ogTitle: 'meta[property="og:title"]',
    ogDescription: 'meta[property="og:description"]'
  },
  ics: {
    prodId: "-//Univesp//NONSGML v1.0//EN",
    calendarScale: "GREGORIAN",
    method: "PUBLISH"
  }
};

const CALENDAR = {
  regular: {
    name: "Cronograma Regular da Univesp",
    nameShort: "Univesp",
    type: "Regular",
    getPeriod: (index) => `${index}º Bimestre`,
    getWeek: (index) => Number(index) === 8 ? "Revisão" : `Semana ${index}`,
    getShortWeek: (index) => Number(index) === 8 ? "Revisão" : `S${index}`
  },
  tcc: {
    name: "Cronograma de TCC da Univesp",
    nameShort: "TCC da Univesp",
    type: "TCC",
    getPeriod: (index) => `${index}º Semestre`,
    getWeek: (index) => `Quinzena ${index}`,
    getShortWeek: (index) => `Q${index}`
  },
  pi: {
    name: "Cronograma de PI da Univesp",
    nameShort: "PI da Univesp",
    type: "PI",
    getPeriod: (index) => `${index}º Semestre`,
    getWeek: (index) => `Quinzena ${index}`,
    getShortWeek: (index) => `Q${index}`
  }
};

const TextUtils = {
  cleanHtmlText: (text) => {
    if (!text || typeof text !== 'string') return '';
    return text
      .replace(/<\/?[^>]+(>|$)/g, ' ')   // Remove todas as tags HTML
      .replace(/\s+/g, ' ')              // Normaliza espaços múltiplos
      .trim();                           // Remove espaços das extremidades
  }
};

const DateUtils = {
  isValidDate: (date) => {
    return typeof date === 'string'
      && /^\d{1,2}\/\d{1,2}\/\d{4}$/.test(date.trim());
  },

  convertDateToISO: (date) => {
    if (!DateUtils.isValidDate(date)) return '';
    const [month, day, year] = date.trim().split('/');
    return `${year}-${month.padStart(2, '0')}-${day.padStart(2, '0')}`;
  },

  convertDateToICS: ({ date, withTime = false }) => {
    const isoDate = DateUtils.convertDateToISO(date);
    return isoDate
      ? isoDate.replace(/-/g, '') + (withTime ? "T235900" : "")
      : "";
  },

  createTimeTag: ({ date, withTime = false }) => {
    const isoDate = DateUtils.convertDateToISO(date);
    if (!isoDate) return '';

    const [year, month, day] = isoDate.split('-');
    const brDate = `${day}/${month}/${year}`;

    return `<time datetime="${isoDate}${withTime ? 'T23:59:00' : ''}">
      ${brDate}${withTime ? ' <span>às 23:59</span>' : ''}
    </time>`;
  }
};

const DataService = {
  getCalendarInfo: () => {
    const match = window.location.pathname.match(/(\d{4})\/cronograma_(\w+)_(\d)\.html/);
    return match
      ? { year: match[1], type: match[2], period: match[3] }
      : { year: new Date().getFullYear(), type: "regular", period: "1" };
  },

  fetchScheduleData: async () => {
    try {
      const { year, type, period } = DataService.getCalendarInfo();
      const controller = new AbortController();
      const timeoutId = setTimeout(() => controller.abort(), 5000);

      const response = await fetch(`/cronograma/${year}/data/cronograma_${type}_${period}.json?t=${Date.now()}`, {
        cache: "no-store",
        signal: controller.signal
      });

      clearTimeout(timeoutId);

      if (!response.ok) {
        throw new Error(`HTTP ${response.status} - ${response.statusText}`);
      }

      const data = await response.json();
      return data ? DataService.normalizeData(data) : null;
    } catch (error) {
      console.error("Falha ao carregar dados:", error);
      return null;
    }
  },

  normalizeData: (weeksArray) => {
    return (weeksArray || [])
      .map(week => {
        const [key, weekData] = Object.entries(week)[0] || [];
        if (!key) return null;

        return {
          weekKey: key,
          weekNumber: key.split("-")[1],
          data: DataService.cleanData(weekData)
        };
      })
      .filter(Boolean);
  },

  cleanData: (weekData) => {
    return Object.fromEntries(
      Object.entries(weekData || {}).map(([key, value]) => [
        key,
        typeof value === 'string' ? value.trim() : value
      ])
    );
  }
};

const ICSGenerator = {
  generateUID() {
    return crypto.randomUUID?.() || Math.random().toString(36).substring(2, 15);
  },

  createEvent: (event) => {
    return [
      "BEGIN:VEVENT",
      `UID:${ICSGenerator.generateUID()}`,
      `SUMMARY:${event.summary}`,
      `DTSTART:${event.start}`,
      event.end && `DTEND:${event.end}`,
      event.description && `DESCRIPTION:${event.description}`,
      "END:VEVENT"
    ].filter(Boolean).join("\n");
  },

  generateContent: (scheduleData, type) => {
    if (!Array.isArray(scheduleData)) return '';

    const { year, period } = DataService.getCalendarInfo();
    const calendarName = CALENDAR[type].name || 'Cronograma Univesp';
    const calendarNameShort = CALENDAR[type].nameShort || 'Univesp';
    const calendarPeriod = CALENDAR[type].getPeriod(period) || '1º Bimestre';

    const events = scheduleData.flatMap(({ weekNumber, data }) => {
      const { inicio, atividade, vencimento, carencia } = data;
      const weekName = CALENDAR[type].getWeek(weekNumber);
      const weekNameShort = CALENDAR[type].getShortWeek(weekNumber);
      const suffix = ` | ${calendarNameShort}, ${year}.${period}`;

      return [
        inicio && {
          summary: atividade
            ? `${weekName} - ${TextUtils.cleanHtmlText(atividade)}${suffix}`
            : `${weekName}${suffix}`,
          start: DateUtils.convertDateToICS({ date: inicio }),
          description: atividade
            ? `Atividade da ${weekName}: ${TextUtils.cleanHtmlText(atividade)}`
            : `Início da ${weekName}, ${calendarPeriod} ${year}`
        },

        vencimento && {
          summary: `${weekNameShort}: Vencimento AA${suffix}`,
          start: DateUtils.convertDateToICS({ date: vencimento, withTime: true }),
          description: `Vencimento das Atividades da ${weekName}`
        },

        carencia && {
          summary: `${weekNameShort}: Carência AA${suffix}`,
          start: DateUtils.convertDateToICS({ date: carencia, withTime: true }),
          description: `Carência das Atividades da ${weekName}`
        }
      ].filter(Boolean).map(ICSGenerator.createEvent);
    });

    return [
      "BEGIN:VCALENDAR",
      "VERSION:2.0",
      `PRODID:${CONFIG.ics.prodId}`,
      `CALSCALE:${CONFIG.ics.calendarScale}`,
      `METHOD:${CONFIG.ics.method}`,
      `X-WR-CALNAME:${calendarName}`,
      `X-WR-CALDESC:${calendarName}`,
      ...events,
      "END:VCALENDAR"
    ].join("\n");
  },

  download: (content, type) => {
    const { year, period } = DataService.getCalendarInfo();
    const blob = new Blob([content], { type: "text/calendar" });
    const url = URL.createObjectURL(blob);

    const link = document.createElement("a");
    link.href = url;
    link.download = `cronograma_${type}_${year}_${period}.ics`;
    link.click();

    setTimeout(() => URL.revokeObjectURL(url), 100);
  }
};

const DOMHelper = {
  // Cache de elementos
  elements: new Map(),

  get(selector) {
    if (!DOMHelper.elements.has(selector)) {
      DOMHelper.elements.set(selector, document.querySelector(selector));
    }
    return DOMHelper.elements.get(selector);
  },

  getAll(selector) {
    return document.querySelectorAll(selector);
  },

  update(selector, content) {
    DOMHelper.getAll(selector).forEach(el => {
      el.textContent = content ?? '';
    });
  },

  toggleVisibility(target, isVisible) {
    const element = typeof target === 'string' ? DOMHelper.get(target) : target;
    if (element) element.classList.toggle('hidden', !isVisible);
  },

  setButtonState(selector, isDisabled) {
    const button = DOMHelper.get(selector);
    if (button) button.disabled = isDisabled;
  }
};

const EventManager = {
  setupDownloadButton: (scheduleData, type, year, period) => {
    const button = document.getElementById(CONFIG.selectors.buttonId);
    if (!button) return;

    button.addEventListener("click", async () => {
      if (button.disabled) return;

      EventManager.showLoadingState(true);

      try {
        const icsContent = ICSGenerator.generateContent(scheduleData, type);
        if (icsContent) {
          await EventManager.simulateDelay(); // Melhora UX

          ICSGenerator.download(icsContent, type);
          EventManager.trackDownloadICS(type, year, period); // Para Google Analytics
          // console.log("ICS gerado com sucesso!");
        }
      } catch (error) {
        console.error("Erro ao gerar ICS:", error);
      } finally {
        EventManager.showLoadingState(false);
      }
    });
  },

  // Para Google Analytics
  trackDownloadICS(type, year, period) {
    if (typeof gtag === 'function') {
      gtag("event", "download_ics", {
        cronograma: `${type}-${year}.${period}`,
        debug_mode: true
      });
    } else {
      console.warn("gtag não inicializado - evento não enviado");
    }
  },

  showLoadingState(show) {
    DOMHelper.setButtonState(`#${CONFIG.selectors.buttonId}`, show);
    DOMHelper.toggleVisibility(CONFIG.selectors.icons.download, !show);
    DOMHelper.toggleVisibility(CONFIG.selectors.icons.loading, show);
  },

  async simulateDelay() {
    return new Promise(resolve =>
      setTimeout(resolve, 1000)
    );
  }
};

const UIManager = {
  updatePageInfo() {
    const { type, year, period } = DataService.getCalendarInfo();
    const config = CALENDAR[type] || CALENDAR.regular;
    const periodName = CALENDAR[type].getPeriod(period) || '1º Bimestre';

    UIManager.updateMetaTags({
      title: `${config.name}, ${year}.${period}`,
      description: `${config.name}, ${periodName} ${year}`
    });

    DOMHelper.update(".h1-subtitle", `${periodName} ${year}`);
    DOMHelper.update(".current-year", new Date().getFullYear());
    DOMHelper.update("[data-calendar-title]", `Univesp ${year}.${period} - ${config.type}`);
  },

  updateMetaTags({ title, description }) {
    document.title = title;
    DOMHelper.get(CONFIG.metaTags.description)?.setAttribute("content", description);
    DOMHelper.get(CONFIG.metaTags.ogTitle)?.setAttribute("content", title);
    DOMHelper.get(CONFIG.metaTags.ogDescription)?.setAttribute("content", description);
  },

  renderSchedule(scheduleData, type) {
    const table = DOMHelper.get(`#${CONFIG.selectors.tableId}`);
    const tbody = table?.querySelector("tbody");
    if (!tbody) return;

    tbody.innerHTML = scheduleData.length
      ? UIManager.generateScheduleRows(scheduleData, type)
      : `<tr><td colspan="4">Nenhum dado disponível</td></tr>`;
  },

  generateScheduleRows(scheduleData, type) {
    return scheduleData.map(({ weekNumber, data }) => {
      const { inicio, atividade, vencimento, carencia } = data;
      const weekName = CALENDAR[type].getWeek(weekNumber);
      const activityText = atividade?.replace(/<br\s*\/?>/gi, ' ').trim();

      return `
        <tr class="mobile-header">
          <th scope="colgroup" colspan="3">${activityText ? `${weekName}: ${activityText}` : weekName}</th>
        </tr>
        <tr>
          <th class="hide-sm" scope="row">${weekName}</th>
          <td>${DateUtils.createTimeTag({ date: inicio })}</td>
          ${atividade ? `<td class="hide-sm">${atividade}</td>` : ""}
          <td>${DateUtils.createTimeTag({ date: vencimento, withTime: true })}</td>
          <td>${DateUtils.createTimeTag({ date: carencia, withTime: true })}</td>
        </tr>
      `;
    }).join("");
  }
};

document.addEventListener("DOMContentLoaded", async () => {
  if (!CONFIG.debugMode) {
    console.log = console.warn = console.error = () => { };
  }

  UIManager.updatePageInfo();

  const { type, year, period } = DataService.getCalendarInfo();
  const scheduleData = await DataService.fetchScheduleData();

  if (scheduleData) {
    UIManager.renderSchedule(scheduleData, type);
    EventManager.setupDownloadButton(scheduleData, type, year, period);
  }
});
