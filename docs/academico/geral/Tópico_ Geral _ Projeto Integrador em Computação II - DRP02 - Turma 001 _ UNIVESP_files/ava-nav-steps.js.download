/* =========================
   Prev/Next Navigation (for Moodle pages with sidebar)
   ========================= */
(() => {
  'use strict';

  const CONFIG = {
    DEBUG: false,

    allowedPaths: ['/mod/'],
    excludedPaths: ['/mod/quiz-test/'],

    selectors: {
      sidebar: '#courseindex',
      navLink: 'a.courseindex-link',
      activeItem: '.courseindex-item.pageitem',
      mountPoint: '[data-ava="pages-nav"]',
      mountFallback: '#region-main',
      stepsWrapper: '.ava-steps-wrapper',
    },

    i18n: {
      prevLabel: 'Página anterior',
      nextLabel: 'Próxima página',
      navAria: 'Navegação entre atividades',
    },
  };

  const log = (...args) => {
    if (CONFIG.DEBUG) console.log('[PrevNextNav]', ...args);
  };

  const normalizeUrl = (url) => url.split('?')[0].split('#')[0];

  const isCourseContentLink = (href) => {
    if (!href) return false;
    return !href.includes('/course/section.php');
  };

  const isAllowedPage = (path) =>
    CONFIG.allowedPaths.some(p => path.includes(p)) &&
    !CONFIG.excludedPaths.some(p => path.includes(p));

  const getSidebarLinks = (sidebar) =>
    Array.from(sidebar.querySelectorAll(CONFIG.selectors.navLink))
      .filter(link => isCourseContentLink(link.getAttribute('href')));

  const findCurrentIndex = (links, sidebar) => {
    const activeItem = sidebar.querySelector(CONFIG.selectors.activeItem);
    log('activeItem found:', activeItem);

    if (activeItem) {
      const currentLink = activeItem.querySelector(CONFIG.selectors.navLink);
      if (currentLink) {
        const index = links.findIndex(link => link.href === currentLink.href);
        if (index !== -1) return index;
      }
    }

    // FALLBACK: If Moodle hasn't added the active class yet, try matching by URL
    log('Active class not found, trying URL fallback...');
    const currentUrl = normalizeUrl(window.location.href);
    const fallbackIndex = links.findIndex(link => normalizeUrl(link.href) === currentUrl);

    if (fallbackIndex !== -1) {
      log('Found current page via URL fallback, index:', fallbackIndex);
      return fallbackIndex;
    }

    log('Current menu item not found at all');
    return -1;
  };

  const getMountTarget = () =>
    document.querySelector(CONFIG.selectors.mountPoint) ??
    document.querySelector(CONFIG.selectors.mountFallback);

  const getStepsWrapper = (target) =>
    target.querySelector(CONFIG.selectors.stepsWrapper);

  const buildStepsLink = (direction, link) => {
    if (!link) return '';

    const isPrev = direction === 'prev';
    const label = isPrev ? CONFIG.i18n.prevLabel : CONFIG.i18n.nextLabel;
    const arrow = isPrev ? 'arrow_back' : 'arrow_forward';
    const arrowClass = isPrev ? 'steps-link-arrow-left' : 'steps-link-arrow-right';

    return `
      <a class="ava-steps-link ${direction}"
         href="${link.href}"
         rel="${direction}">
        <span class="desc">${label}</span>
        <span class="title">${link.textContent.trim()}</span>
        <span class="material-symbols-outlined ${arrowClass}" aria-hidden="true">
          ${arrow}
        </span>
      </a>`;
  };

  const buildSkeleton = () => `
    <nav class="ava-steps skeleton" aria-hidden="true">
      <span class="ava-steps-link prev">
        <span class="desc">${CONFIG.i18n.prevLabel}</span>
        <span class="title"></span>
        <span class="material-symbols-outlined steps-link-arrow-left" aria-hidden="true">arrow_back</span>
      </span>
      <span class="ava-steps-link next">
        <span class="desc">${CONFIG.i18n.nextLabel}</span>
        <span class="title"></span>
        <span class="material-symbols-outlined steps-link-arrow-right" aria-hidden="true">arrow_forward</span>
      </span>
    </nav>`;

  const buildNavSteps = (prev, next) => `
    <nav class="ava-steps" aria-label="${CONFIG.i18n.navAria}">
      ${buildStepsLink('prev', prev)}
      ${buildStepsLink('next', next)}
    </nav>`;

  const insertSkeleton = () => {
    if (!isAllowedPage(location.pathname)) return;

    const target = getMountTarget();
    if (!target || getStepsWrapper(target)) return;

    const wrapper = document.createElement('div');
    wrapper.className = CONFIG.selectors.stepsWrapper.replace('.', '');
    wrapper.innerHTML = buildSkeleton();

    target.appendChild(wrapper);
  };

  const render = () => {
    try {
      if (!isAllowedPage(location.pathname)) return;

      const sidebar = document.querySelector(CONFIG.selectors.sidebar);
      const target = getMountTarget();

      if (!sidebar || !target) return;

      const links = getSidebarLinks(sidebar);
      const wrapper = getStepsWrapper(target);

      if (!links.length || !wrapper) return;

      const currentIndex = findCurrentIndex(links, sidebar);

      if (currentIndex === -1) {
        log('Current page not found in sidebar yet');
        wrapper.hidden = true;
        return;
      }

      const prev = links[currentIndex - 1] ?? null;
      const next = links[currentIndex + 1] ?? null;

      const newHref = (prev?.href ?? '') + '|' + (next?.href ?? '');
      if (wrapper.dataset.rendered === newHref) return;
      wrapper.dataset.rendered = newHref;

      if (!prev && !next) {
        wrapper.hidden = true;
        return;
      }

      wrapper.hidden = false;
      wrapper.innerHTML = buildNavSteps(prev, next);
      requestAnimationFrame(() => wrapper.classList.add('visible'));

      log('Rendered successfully');

    } catch (err) {
      log('Render error:', err);
    }
  };

  let renderPending = false;

  const scheduleRender = () => {
    if (renderPending) return;
    renderPending = true;

    requestAnimationFrame(() => {
      renderPending = false;
      render();
    });
  };

  let sidebarObserver = null;

  window.addEventListener('pagehide', () => sidebarObserver?.disconnect());

  const attachSidebarObserver = (sidebar) => {
    sidebarObserver?.disconnect();

    sidebarObserver = new MutationObserver((mutations) => {
      log('sidebar mutation detected');
      scheduleRender();
    });

    sidebarObserver.observe(sidebar, {
      childList: true,
      subtree: true,
      attributes: true,
      attributeFilter: ['class']
    });

    log('Observer attached to sidebar');
  };

  const observeSidebar = () => {
    const sidebar = document.querySelector(CONFIG.selectors.sidebar);

    if (sidebar) {
      attachSidebarObserver(sidebar);
      scheduleRender();
      return;
    }

    const discoveryObserver = new MutationObserver((_, obs) => {
      const el = document.querySelector(CONFIG.selectors.sidebar);
      if (!el) return;

      obs.disconnect();
      attachSidebarObserver(el);
      scheduleRender();
    });

    discoveryObserver.observe(document.body, { childList: true, subtree: true });
  };

  const init = () => {
    insertSkeleton();
    observeSidebar();
  };

  init();

})();