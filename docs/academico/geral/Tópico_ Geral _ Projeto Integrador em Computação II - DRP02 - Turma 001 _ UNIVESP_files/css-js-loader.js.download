(() => {
  const ASSETS_BASE = 'https://assets.univesp.br/moodle';
  const CONFIG = {
    DEFAULT: { css: 'v1', js: null },
    TEA001: { css: 'v2-a', js: 'v2-a' },
    FAM001: { css: 'v1-c', js: 'v1-c' },
    MAG001: { css: 'v1-a', js: 'v1-b' }
  };
  const MAX_WAIT = 1000;

  const loadAssets = (el) => {
    if (el.dataset.assetsInitialized) return;
    el.dataset.assetsInitialized = 'true';

    const code = el.dataset.courseCode;
    const { css, js } = CONFIG[code] || CONFIG.DEFAULT;

    let revealed = false;
    const reveal = () => {
      if (revealed) return;
      revealed = true;
      el.classList.add('is-ready');
    };

    const timer = setTimeout(reveal, MAX_WAIT);

    // CSS
    if (css && typeof css === 'string') {
      const href = `${ASSETS_BASE}/css/${code}/styles.css?v=${css}`;

      let link = document.querySelector(`link[href="${href}"]`);

      if (!link) {
        link = document.createElement('link');
        link.rel = 'stylesheet';
        link.href = href;
        link.onload = () => { clearTimeout(timer); reveal(); };
        link.onerror = reveal;
        // link.onerror = () => {
        //   console.error(`[AssetsLoader] Failed CSS: ${href}`);
        //   reveal();
        // };
        document.head.appendChild(link);
      } else {
        clearTimeout(timer);
        reveal();
      }
    } else {
      reveal();
    }

    // JS (non-blocking)
    if (js && typeof js === 'string') {
      const src = `${ASSETS_BASE}/js/${code}/script.js?v=${js}`;
      if (!document.querySelector(`script[src="${src}"]`)) {
        const script = document.createElement('script');
        script.src = src;
        script.async = true;
        // script.onerror = () => {
        //   console.error(`[AssetsLoader] Failed JS: ${src}`);
        // };
        document.head.appendChild(script);
      }
    }
  };

  // Scan
  const scan = () => {
    const targets = document.querySelectorAll('[data-course-code]:not([data-assets-initialized])');
    targets.forEach(loadAssets);
  };

  // Scheduler
  let frameRequested = false;
  const requestScan = () => {
    if (frameRequested) return;
    frameRequested = true;

    requestAnimationFrame(() => {
      scan();
      frameRequested = false;
    });
  };

  // First scan
  scan();

  const observer = new MutationObserver((mutations) => {
    for (const mutation of mutations) {
      if (mutation.addedNodes.length) {
        requestScan();
        break;
      }
    }
  });

  observer.observe(document.body, { childList: true, subtree: true });
})();