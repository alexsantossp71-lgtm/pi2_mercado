(() => {
  'use strict';

  if (window.__CUSTOM_AVA_SCRIPT__) return;
  window.__CUSTOM_AVA_SCRIPT__ = true;

  /* =========================
     Hiding Material Symbols Icons from screen readers
     ========================= */
  function hideIcons(selector = '.material-symbols-outlined') {
    document.querySelectorAll(selector).forEach(icon => {
      icon.setAttribute('aria-hidden', 'true');
      icon.setAttribute('translate', 'no');
    });
  }

  /* =========================
     Accordion behavior (one open in a group)
     ========================= */
  function initAccordionBehavior() {
    function closeOtherAccordions(event) {
      const clickedSummary = event.target.closest('summary');
      if (!clickedSummary) return;

      const group = clickedSummary.closest('.ava-scope .details-group');
      if (!group) return;

      group.querySelectorAll('summary').forEach(summary => {
        if (summary !== clickedSummary) {
          summary.parentNode.removeAttribute('open');
        }
      });
    }

    document.addEventListener('click', closeOtherAccordions);
  }

  /* =========================
     Image randomizer for personage (In Sintese)
     ========================= */
  function initPersonageRandomizer() {
    const images = [
      'pers_band_azul.gif',
      'pers_band_vermelho.gif',
      'pers_band_amarelo.gif',
      'pers_band_verde.gif',
      'pers_band_roxo.gif'
    ];
    const imgEl = document.querySelector('.personage-foto');
    if (!imgEl) return;

    const getRand = (min, max) => Math.floor(Math.random() * (max - min + 1)) + min;

    function randomize() {
      const idx = getRand(0, images.length - 1);
      imgEl.src = `https://assets.univesp.br/canvas/img/${images[idx]}`;
    }

    randomize();
  }

  /* =========================
     Accessible tabs navigation:
     <div class="tabs-wrapper">
       <ul class="tabs-nav">
         <li><button data-tab="item-1">Button 1</button></li>
         <li><button data-tab="item-2">Button 2</button></li>
       </ul>
       <div class="tabs-panels">
         <div data-panel="item-1">This is the content of the first tab.</div>
         <div data-panel="item-2">This is the content of the second tab.</div>
       </div>
     </div>
     ========================= */
  function initializeTabs(wrapper, wrapperIndex) {
    const nav = wrapper.querySelector('.ava-scope .tabs-nav') || wrapper.querySelector('.ava-scope .tabs-nav-vertical');
    const panelsContainer = wrapper.querySelector('.ava-scope .tabs-panels');

    if (!nav || !panelsContainer) {
      // console.warn('Tabs initialization skipped: Missing navigation or panels container.', wrapper);
      return;
    }

    const tabs = Array.from(nav.querySelectorAll('[data-tab]'));
    const panels = Array.from(panelsContainer.querySelectorAll('[data-panel]'));

    if (!tabs.length || !panels.length) return;

    // Create a map of panels for easy access
    const panelMap = new Map();
    panels.forEach(panel => {
      const key = panel.getAttribute('data-panel');
      if (key) {
        panelMap.set(key, panel);
      }
    });

    nav.setAttribute('role', 'tablist');
    let activeIndex = 0;

    const activateTab = (index) => {
      if (index < 0 || index >= tabs.length) return;
      activeIndex = index;

      tabs.forEach((tab, i) => {
        const key = tab.getAttribute('data-tab');
        const panel = panelMap.get(key);
        if (!panel) return;

        const isSelected = i === index;

        tab.setAttribute('aria-selected', isSelected ? 'true' : 'false');
        tab.setAttribute('tabindex', isSelected ? '0' : '-1');

        panel.hidden = !isSelected;

        if (isSelected) {
          tab.focus();
        }
      });
    };

    // Initialize ARIA, ID for tabs and panels
    tabs.forEach((tab, i) => {
      const key = tab.getAttribute('data-tab');
      const panel = panelMap.get(key);
      if (!panel) return;

      const isSelected = i === 0;

      // Generate unique ID if not present
      tab.id = tab.id || `tab-${wrapperIndex}-${i + 1}`;
      panel.id = panel.id || `panel-${wrapperIndex}-${i + 1}`;

      // Set ARIA-attributes for tabs
      tab.setAttribute('role', 'tab');
      tab.setAttribute('aria-controls', panel.id);
      tab.setAttribute('aria-selected', isSelected ? 'true' : 'false');
      tab.setAttribute('tabindex', isSelected ? '0' : '-1');
      tab.parentNode.setAttribute('role', 'none');

      // Set ARIA-attributes for panels (content areas)
      panel.setAttribute('role', 'tabpanel');
      panel.setAttribute('aria-labelledby', tab.id);
      panel.hidden = !isSelected;
      panel.setAttribute('tabindex', '0');
    });

    tabs.forEach((tab, i) => {
      tab.addEventListener('click', () => {
        activateTab(i);
      });
    });

    // Keyboard Navigation Handler (WAI-ARIA)
    const handleKeydown = (e) => {
      let newIndex = activeIndex;

      switch (e.key) {
        case 'ArrowLeft':
        case 'ArrowUp':
          e.preventDefault();
          // Cyclic navigation backwards
          newIndex = (activeIndex - 1 + tabs.length) % tabs.length;
          activateTab(newIndex);
          break;

        case 'ArrowRight':
        case 'ArrowDown':
          e.preventDefault();
          // Cyclic navigation forwards
          newIndex = (activeIndex + 1) % tabs.length;
          activateTab(newIndex);
          break;

        case 'Home':
          e.preventDefault();
          activateTab(0);
          break;

        case 'End':
          e.preventDefault();
          activateTab(tabs.length - 1);
          break;
      }
    };

    tabs.forEach(tab => {
      tab.addEventListener('keydown', handleKeydown);
    });
  }

  function initAllTabsBlock() {
    const wrappers = document.querySelectorAll('.ava-scope .tabs-wrapper');
    if (!wrappers.length) return;

    wrappers.forEach((wrapper, wrapperIndex) => {
      try {
        initializeTabs(wrapper, wrapperIndex + 1);
      } catch (err) {
        // Tolerant error handling: if one unit fails, the others continue to work
        // console.error('Failed to initialize tabs block:', err, wrapper);
      }
    });
  }

  /* =========================
   Expandable Text Component:
    <div class="expandable-text" data-lines="3">
      <div class="expandable-text-inner"> Long text content here...</div>
      <button class="expandable-text-btn" hidden>Mostrar mais</button>
    </div>
   ========================= */
  function setupExpandableText(container) {
    const text = container.querySelector('.expandable-text-inner');
    const button = container.querySelector('.expandable-text-btn');
    if (!text || !button) return;

    const lines = container.dataset.lines;
    if (lines) {
      container.style.setProperty('--readmore-lines', lines);
    }

    function shouldShow() {
      return text.scrollHeight > text.clientHeight;
    }

    function updateUI() {
      const expanded = container.classList.contains('is-expanded');

      if (expanded) {
        button.hidden = false;
        return;
      }

      button.hidden = !shouldShow();
    }

    button.addEventListener('click', function () {
      const expanded = container.classList.toggle('is-expanded');
      button.textContent = expanded
        ? 'Mostrar menos'
        : 'Mostrar mais';
    });

    const observer = new ResizeObserver(updateUI);
    observer.observe(text);

    updateUI();
  }

  function initExpandableTextComponents() {
    document
      .querySelectorAll('.ava-scope .expandable-text')
      .forEach(setupExpandableText);
  }

  /* =========================
   Normalize white/yellow/green inline backgrounds in quiz answers
   ========================= */
  function normalizeQuizAnswerBackgrounds() {
    const questions = document.querySelectorAll('.que, [id^="question-"]');

    if (!questions.length) return;

    const removableColors = [
      'rgb(255, 255, 255)',  // white
      'rgb(255, 255, 0)',    // yellow
      'rgb(0, 255, 0)'       // lime
    ];

    questions.forEach(question => {
      question.querySelectorAll(
        '.qtext [style*="background"],' +
        '.answer [style*="background"]'
      ).forEach(el => {
        const bg = getComputedStyle(el).backgroundColor;

        if (removableColors.includes(bg)) {
          el.style.background = 'transparent';
        }
      });
    });
  }

  function init() {
    hideIcons();
    initAccordionBehavior();
    initPersonageRandomizer();
    initAllTabsBlock();
    initExpandableTextComponents();
    normalizeQuizAnswerBackgrounds();
  }

  document.readyState === 'loading'
    ? document.addEventListener('DOMContentLoaded', init)
    : init();
})();